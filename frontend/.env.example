# Cognito Configuration
# Obtén estos valores en tu consola de AWS Cognito: https://console.aws.amazon.com/cognito/

# URL base de tu dominio Cognito
VITE_AUTH0_DOMAIN=https://tu-dominio.auth.region.amazoncognito.com

# Client ID de tu aplicación Cognito
VITE_AUTH0_CLIENT_ID=tu-client-id

# URL a donde Cognito redirigirá después del login (Callback URL)
VITE_AUTH0_CALLBACK_URL=http://localhost:5173/

# URL a donde redirigir después del logout
VITE_AUTH0_LOGOUT_URL=http://localhost:5173

# Endpoint de token de Cognito (para intercambiar código por token)
VITE_COGNITO_TOKEN_ENDPOINT=https://tu-dominio.auth.region.amazoncognito.com/oauth2/token

# JWKS URI de Cognito (para verificar tokens en producción)
VITE_COGNITO_JWKS_URI=https://cognito-idp.region.amazonaws.com/region_userPoolId/.well-known/jwks.json

