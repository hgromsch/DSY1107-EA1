# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules
package-lock.json
yarn.lock
pnpm-lock.yaml

# Production build
dist
dist-ssr
*.local

# ============================================
# Terraform Ignores
# ============================================

# Terraform state files
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Terraform lock file
.terraform.lock.hcl

# Terraform directory (plugins, modules, etc.)
.terraform/

# Terraform variables files
*.tfvars
*.tfvars.json
!example.tfvars

# Terraform plan files
*.tfplan

